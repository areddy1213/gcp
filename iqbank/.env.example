# Copy to .env (git-ignored) and fill in what you have. Sources with missing
# credentials are skipped with a warning; the inbox needs nothing.

# Claude (extraction, dedupe, loop summary). Or run `ant auth login` instead.
ANTHROPIC_API_KEY=
# IQBANK_MODEL=claude-sonnet-5-5
# IQBANK_EFFORT=medium          # low | medium | high
# IQBANK_FALLBACKS=1            # 0 to disable server-side refusal fallbacks

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for: <platform>:<app id>:<version> (by u/<your username>)
REDDIT_USER_AGENT=script:iqbank:0.1 (by u/your_username)

# Web search: set one. Serper (serper.dev) or Brave Search API.
SERPER_API_KEY=
BRAVE_API_KEY=
# SEARCH_PROVIDER=serper        # only needed if both keys are set

# GitHub: a fine-grained token with no extra permissions ("Public repositories (read-only)")
GITHUB_TOKEN=

# Optional
# IQBANK_BLOCKLIST=example.com,another.example   # added to the default blocklist
# IQBANK_USER_AGENT=iqbank/0.1 (personal interview-prep research)
